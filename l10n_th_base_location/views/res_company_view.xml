<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">company.form.address.extended.subdistrict_id</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base_location.view_company_form_city" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zip_id']" position="after">
                <field name="country_enforce_subdistrict" invisible="1" />
                <field
                    name="subdistrict_id"
                    placeholder="SubDistrict"
                    domain="[('city_id', '=', city_id)]"
                    invisible="not country_enforce_subdistrict"
                    readonly="parent_id"
                />
                <field name="city_id" position="move" />
            </xpath>
        </field>
    </record>
</odoo>
