<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_with_container" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field
                    name="tax_invoice_number"
                    invisible="picking_type_code != 'incoming'"
                />
                <field
                    name="tax_invoice_date"
                    invisible="picking_type_code != 'incoming'"
                />
            </xpath>
        </field>
    </record>

    <record id="vpicktree" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="tax_invoice_number" optional="show" />
                <field name="tax_invoice_date" optional="show" />
            </field>
        </field>
    </record>
</odoo>
