<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="bank_payment_export_view_form" model="ir.ui.view">
        <field name="name">bank.payment.export.view.form</field>
        <field name="model">bank.payment.export</field>
        <field
            name="inherit_id"
            ref="l10n_th_bank_payment_export.bank_payment_export_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='information']//group[@name='left_information']"
                position="inside"
            >
                <field name="ttb_is_editable" invisible="1" />
                <field
                    name="ttb_transaction_type"
                    attrs="{'invisible': [('ttb_is_editable', '!=', True)], 'required': [('ttb_is_editable', '!=', False)]}"
                />
                <field
                    name="ttb_transaction_code"
                    attrs="{
                        'invisible': ['|', ('ttb_is_editable', '!=', True), ('ttb_transaction_type', 'in', ['MCP', 'COP'])],
                        'required': [('ttb_is_editable', '!=', False), ('ttb_transaction_type', 'not in', ['MCP', 'COP'])]
                    }"
                />
                <field
                    name="ttb_delivery_method"
                    attrs="{
                        'invisible': [('ttb_transaction_type', 'not in', ['MCP', 'COP'])],
                        'required': [('ttb_transaction_type', 'in', ['MCP', 'COP'])]
                    }"
                />
                <field
                    name="ttb_pickup_location"
                    attrs="{
                        'invisible': [('ttb_delivery_method', 'not in', ['OC', 'RT'])],
                        'required': [('ttb_delivery_method', 'in', ['OC', 'RT'])]
                    }"
                />
                <field
                    name="ttb_document_required"
                    attrs="{'invisible': [('ttb_is_editable', '!=', True)]}"
                />
                <field
                    name="ttb_payment_details"
                    attrs="{'invisible': [('ttb_is_editable', '!=', True)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
