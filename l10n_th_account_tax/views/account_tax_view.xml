<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_tax_form" model="ir.ui.view">
        <field name="name">account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="after">
                <field
                    name="taxinv_sequence_id"
                    invisible="type_tax_use != 'sale' or is_withholding_tax"
                    context="{'default_implementation': 'no_gap', 'default_name': name, 'default_padding': 4, 'default_use_date_range': True}"
                />
                <field
                    name="sequence_number_next"
                    invisible="type_tax_use != 'sale' or is_withholding_tax or not taxinv_sequence_id"
                />
            </xpath>
        </field>
    </record>
    <record id="view_tax_form_withholding" model="ir.ui.view">
        <field name="name">account.tax.form.withholding</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="l10n_account_withholding_tax.view_tax_form" />
        <field name="arch" type="xml">
            <field name="is_withholding_tax" position="after">
                <field
                    name="is_pit"
                    invisible="not is_withholding_tax or type_tax_use != 'purchase' or country_code != 'TH'"
                />
            </field>
            <!-- PIT amount is computed on payment from the PIT rate table -->
            <field name="amount_type" position="attributes">
                <attribute name="invisible">is_pit</attribute>
            </field>
            <xpath expr="//label[@for='amount']" position="attributes">
                <attribute name="invisible" add="is_pit" separator=" or " />
            </xpath>
            <xpath
                expr="//label[@for='amount']/following-sibling::div[1]"
                position="attributes"
            >
                <attribute name="invisible" add="is_pit" separator=" or " />
            </xpath>
        </field>
    </record>
</odoo>
