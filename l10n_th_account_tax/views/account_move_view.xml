<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="button_wht_certs"
                    type="object"
                    class="oe_stat_button"
                    icon="description"
                    groups="account.group_account_invoice"
                    invisible="not wht_cert_ids"
                >
                    <field name="wht_cert_ids" widget="statinfo" string="WHT Certs" />
                </button>
            </div>
            <xpath expr="//header[last()]" position="after">
                <field name="wht_cert_status" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'none' or state != 'posted'"
                >
                    This entry contains withholding tax, but no withholding tax
                    certificates have been created yet.
                    <button
                    name="action_create_wht_cert"
                    string="⇒ Create withholding tax cert."
                    type="object"
                    class="oe_link"
                    title="Create withholding tax certificates from the posted entry"
                />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'draft'"
                >
                    Withholding tax certificates have been created but are still draft.
                    <button
                    name="button_wht_certs"
                    string="⇒ Show withholding tax certs"
                    type="object"
                    class="oe_link"
                />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'cancel'"
                >
                    All related withholding tax certificates were cancelled.
                    <button
                    name="button_wht_certs"
                    string="⇒ Show withholding tax certs"
                    type="object"
                    class="oe_link"
                />
                    <button
                    name="action_create_wht_cert"
                    string="⇒ Create withholding tax cert."
                    type="object"
                    class="oe_link"
                    invisible="state != 'posted'"
                    title="Create withholding tax certificates from the posted entry"
                />
                </div>
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//field[@name='tax_tag_ids']"
                position="after"
            >
                <field
                    name="manual_tax_invoice"
                    optional="hide"
                    column_invisible="parent.country_code != 'TH'"
                />
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="before">
                <page
                    id="tax_invoice"
                    string="Tax Invoice"
                    invisible="not tax_invoice_ids"
                >
                    <field name="tax_invoice_ids" readonly="state != 'draft'">
                        <list editable="bottom" create="0" delete="1">
                            <field name="move_state" column_invisible="1" />
                            <field name="account_id" optional="hide" />
                            <field name="partner_id" optional="hide" />
                            <field name="tax_invoice_number" />
                            <field name="tax_invoice_date" />
                            <field name="report_late_mo" optional="show" />
                            <field name="report_date" optional="show" />
                            <field name="tax_base_amount" />
                            <field name="balance" sum="Tax Amount" />
                            <button
                                name="copy"
                                string="Split"
                                type="object"
                                icon="content_copy"
                                invisible="move_state != 'draft'"
                            />
                            <field name="company_currency_id" column_invisible="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <!-- No standard Thai tax invoices, see Tax Invoice tab above -->
    <record id="view_move_form_th" model="ir.ui.view">
        <field name="name">account.move.form.th</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_th.view_move_form_th_inherit" />
        <field name="arch" type="xml">
            <page id="tax_invoice_tab" position="attributes">
                <attribute name="invisible">1</attribute>
            </page>
        </field>
    </record>
    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='date']" position="before">
                <filter
                    name="wht_not_created"
                    string="WHT Not yet created"
                    domain="[('has_wht', '=', True), ('wht_cert_ids', '=', False)]"
                />
                <separator />
            </xpath>
        </field>
    </record>
</odoo>
