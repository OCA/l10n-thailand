<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="button_wht_certs"
                    type="object"
                    class="oe_stat_button"
                    icon="description"
                    groups="account.group_account_invoice"
                    invisible="wht_certs_count == 0"
                >
                    <field
                        name="wht_certs_count"
                        widget="statinfo"
                        string="WHT Certs"
                    />
                </button>
            </div>
            <xpath expr="//form/header/button[@name='action_post']" position="after">
                <field name="to_clear_tax" invisible="1" />
                <button
                    name="open_clear_tax"
                    type="object"
                    string="Clear Tax"
                    class="oe_highlight"
                    invisible="not to_clear_tax or state == 'draft'"
                    groups="account.group_account_invoice"
                />
            </xpath>
            <notebook name="payment_notebook" position="inside">
                <page
                    string="Tax Invoice"
                    name="tax_invoice"
                    invisible="not tax_invoice_ids"
                >
                    <field name="tax_invoice_ids">
                        <list editable="bottom" create="0" delete="1">
                            <field name="move_state" column_invisible="1" />
                            <field name="move_id" optional="show" />
                            <field name="account_id" optional="hide" />
                            <field name="partner_id" optional="hide" />
                            <field
                                name="tax_invoice_number"
                                readonly="move_state != 'draft'"
                            />
                            <field
                                name="tax_invoice_date"
                                readonly="move_state != 'draft'"
                            />
                            <field
                                name="report_late_mo"
                                readonly="move_state != 'draft'"
                                optional="show"
                            />
                            <field name="report_date" optional="show" />
                            <field name="tax_base_amount" />
                            <field name="balance" sum="Total Tax" />
                            <button
                                name="copy"
                                string="Split"
                                type="object"
                                icon="content_copy"
                                invisible="move_state != 'draft'"
                            />
                            <field name="company_currency_id" column_invisible="1" />
                        </list>
                    </field>
                </page>
            </notebook>
            <xpath expr="//header[last()]" position="after">
                <field name="wht_cert_status" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'none'
                        or state not in ('paid', 'reconciled')"
                >
                    This entry contains withholding tax, but no withholding tax
                    certificates have been created yet.
                    <button
                    name="action_create_wht_cert"
                    string="⇒ Create withholding tax cert."
                    type="object"
                    class="oe_link"
                    title="Create withholding tax certificates from the posted entry"
                />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'draft'"
                >
                    Withholding tax certificates have been created but are still draft.
                    <button
                    name="button_wht_certs"
                    string="⇒ Show withholding tax certs"
                    type="object"
                    class="oe_link"
                />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    style="margin-bottom:0px;"
                    invisible="wht_cert_status != 'cancel'"
                >
                    All related withholding tax certificates were cancelled.
                    <button
                    name="button_wht_certs"
                    string="⇒ Show withholding tax certs"
                    type="object"
                    class="oe_link"
                />
                    <button
                    name="action_create_wht_cert"
                    string="⇒ Create withholding tax cert."
                    type="object"
                    class="oe_link"
                    invisible="state not in ('paid', 'reconciled')"
                    title="Create withholding tax certificates from the posted entry"
                />
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="name">account.payment.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='date']" position="before">
                <filter
                    name="wht_not_created"
                    string="WHT Not yet created"
                    domain="[('has_wht', '=', True), ('wht_cert_ids', '=', False)]"
                />
                <separator />
            </xpath>
        </field>
    </record>
    <!-- 50 Tawi are printed from the withholding tax certificates -->
    <record id="view_account_payment_form_th" model="ir.ui.view">
        <field name="name">account.payment.form.th</field>
        <field name="model">account.payment</field>
        <field
            name="inherit_id"
            ref="l10n_th.view_account_payment_form_inherit_l10n_th"
        />
        <field name="arch" type="xml">
            <button name="action_l10n_th_print_50_tawi" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
        </field>
    </record>
    <record id="l10n_th.action_download_50_tawi_zip" model="ir.actions.server">
        <field name="binding_model_id" eval="False" />
    </record>
</odoo>
