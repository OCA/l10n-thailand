<odoo>
    <record id="procurement_type_view_list" model="ir.ui.view">
        <field name="name">procurement.type.view.list</field>
        <field name="model">procurement.type</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="sequence" widget="handle" />
                <field name="active" invisible="True" />
                <field name="name" />
                <field name="description" />
                <field name="product_id" />
            </list>
        </field>
    </record>

    <record id="procurement_type_view_form" model="ir.ui.view">
        <field name="name">procurement.type.view.form</field>
        <field name="model">procurement.type</field>
        <field name="arch" type="xml">
            <form string="Procurement Types">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="product_id" />
                        </group>
                        <group>
                            <field name="description" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="procurement_type_action" model="ir.actions.act_window">
        <field name="name">Procurement Types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">procurement.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="procurement_type_view_list" />
    </record>
</odoo>
