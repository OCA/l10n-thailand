<odoo>
    <record id="view_purchase_requisition_form" model="ir.ui.view">
        <field name="name">purchase.requisition.form</field>
        <field name="model">purchase.requisition</field>
        <field
            name="inherit_id"
            ref="purchase_requisition.view_purchase_requisition_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_purchase_guarantee"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-list-alt"
                >
                    <field
                        name="purchase_guarantee_count"
                        widget="statinfo"
                        string="Guarantee"
                    />
                </button>
            </div>
            <xpath
                expr="//page[@name='products']//list/field[@name='analytic_distribution']"
                position="after"
            >
                <field
                    name="analytic_tag_ids"
                    widget="many2many_tags"
                    optional="show"
                    groups="account_analytic_tag.group_analytic_tags"
                />
            </xpath>
        </field>
    </record>
</odoo>
