    <record id="account_tax_filing_view_form" model="ir.ui.view">
        <field name="name">account.tax.filing.view.form</field>
        <field name="model">account.tax.filing</field>
        <field name="arch" type="xml">
            <form string="Tax Filing">
                <header>
                    <button
                        name="action_submit"
                        type="object"
                        string="Submit"
                        states="draft"
                        class="oe_highlight"
                    />
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        class="oe_highlight"
                        states="submit"
                    />
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('move_id', '!=', False), ('state', '!=', 'done')]}"
                    />
                    <button
                        name="action_draft"
                        type="object"
                        string="Set to Draft"
                        states="submit"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        states="draft,done"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submit,done"
                    />
                </header>
                <sheet>
                    <div
                        class="oe_button_box"
                        name="button_box"
                        attrs="{'invisible': [('move_id', '=', False)]}"
                    >
                        <button
                            name="action_view_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            attrs="{'invisible': [('move_type', '!=', 'entry')]}"
                        >
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Journal Entry</span>
                                </div>
                        </button>
                        <button
                            name="action_view_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"
                        >
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Invoiced</span>
                                </div>
                        </button>
                        <button
                            name="action_view_entries"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}"
                        >
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Vendor Bill</span>
                                </div>
                        </button>
                    </div>
                    <h1 class="mt0">
                        <field name="name" />
                    </h1>
                    <group>
                        <group>
                            <field name="date_range_id" />
                            <field name="date_from" required="1" />
                            <field name="date_to" required="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="move_id" invisible="1" />
                            <field name="move_type" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Journal items">
                            <div class="oe_read_only oe_right" name="buttons">
                                <button
                                    type="object"
                                    name="action_compute_account_tax_filing_line"
                                    string="Compute"
                                    states="draft"
                                    icon="fa-refresh"
                                />
                            </div>
                            <field
                                name="tax_filing_line_ids"
                                widget="section_and_note_one2many"
                            >
                                <tree editable="bottom" delete="1" create="0">
                                    <field name="display_type" invisible="1" />
                                    <field name="account_id" />
                                    <field name="name" widget="section_and_note_text" />
                                    <field name="move_line_id" />
                                    <field name="date" />
                                    <field name="debit" />
                                    <field name="credit" />
                                    <field name="currency_id" invisible="1" />
                                    <field name="company_id" invisible="1" />
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_from" string="Sales Amount" />
                                <field name="amount_to" string="Purchases Amount" />
                                <field name="amount_adjust" string="Adjusted Amount" />
                                <field
                                    name="total_amount"
                                    class="oe_subtotal_footer_separator"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
            </form>
        </field>
    </record>

    <record id="account_tax_filing_view_tree" model="ir.ui.view">
        <field name="name">account.tax.filing.view.tree</field>
        <field name="model">account.tax.filing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="date_range_id" optional="show" />
                <field name="date_from" string="Start Date" widget="date" />
                <field name="date_to" string="End Date" widget="date" />
                <field name="partner_id" optional="hide" />
                <field name="total_amount" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state in 'done,submit'"
                    decoration-danger="state == 'cancel'"
                    decoration-info="state == 'draft'"
                />
            </tree>
        </field>
    </record>

    <record id="account_tax_filing_search_view" model="ir.ui.view">
        <field name="name">account.tax.filing.search</field>
        <field name="model">account.tax.filing</field>
        <field name="arch" type="xml">
            <search string="Tax Filing">
                <field name="name" />
                <field name="partner_id" />
                <filter
                    string="Draft"
                    name="draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Submitted"
                    name="submit"
                    domain="[('state', '=', 'submit')]"
                />
                <filter string="Done" name="done" domain="[('state', '=', 'done')]" />
                <filter
                    string="Cancel"
                    name="cancel"
                    domain="[('state', '=', 'cancel')]"
                />
                <filter
                    string="State"
                    name="group_by_state"
                    context="{'group_by': 'state'}"
                />
                <filter
                    string="Partner"
                    name="group_by_partner"
                    context="{'group_by': 'partner_id'}"
                />
                <filter
                    string="Date Range"
                    name="group_by_date_range"
                    context="{'group_by': 'date_range_id'}"
                />
                <filter
                    string="Start Date"
                    name="group_by_date_from"
                    context="{'group_by': 'date_from'}"
                />
                <filter
                    string="End Date"
                    name="group_by_date_to"
                    context="{'group_by': 'date_to'}"
                />
            </search>
        </field>
    </record>

    <record id="account_tax_filing_action" model="ir.actions.act_window">
        <field name="name">Tax Filing</field>
        <field name="res_model">account.tax.filing</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_account_tax_filing"
        name="Tax Filing"
        parent="account.menu_finance_entries_actions"
        action="account_tax_filing_action"
    />
</odoo>
